# .env.example — copia como .env y define los valores antes de levantar Docker.
# Los campos sin valor por defecto hacen fallar el arranque si no se definen.

# Contrasena del usuario sa de SQL Server (administrador)
CITAS_SA_PASSWORD=CAMBIAR_ANTES_DE_DESPLEGAR

# Usuario y contrasena de la aplicacion (rol restringido)
CITAS_APP_USER=citas_app
CITAS_APP_PASSWORD=CAMBIAR_ANTES_DE_DESPLEGAR

# Nombre de la base de datos
CITAS_DB=citas_medicas

# Puerto local de SQL Server (evitar colision con otras instancias del ecosistema)
CITAS_SQL_PORT=14350
